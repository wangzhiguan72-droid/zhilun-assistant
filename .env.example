# 智论助手 · 环境变量样例
# ========================================
# 复制本文件为 .env，然后填入你的真实 Key。
# .env 已经被 .gitignore 排除，不会被推到 Git。
# 绝对不要把 Key 直接写进代码。

# ─── 必需①：硅基流动 API Key ──────────────────────────
# 从 https://cloud.siliconflow.cn/account/ak 申请
# 免费档：deepseek-ai/DeepSeek-V4-Flash、THUDM/GLM-Z1-9B-0414
# 付费档：deepseek-ai/DeepSeek-V4-Pro（paper_check 深度审计用）
SILICONFLOW_API_KEY=

# 可选：自定义 base URL（默认 https://api.siliconflow.cn/v1，一般不用改）
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ─── 必需②：智谱 BigModel API Key（v0.4 新增）─────────
# 从 https://bigmodel.cn/apikey/platform 申请
# 免费模型：glm-4.7-flash（**永久免费**，200K 上下文，混合思考 30B/A3B）
# 没填这个 Key 时，Router 会自动退回硅基流动的免费档（不影响服务）
ZHIPU_API_KEY=

# 可选：智谱自定义 base URL（默认 https://open.bigmodel.cn/api/paas/v4，一般不用改）
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ─── 未来扩展位 ─────────────────────────
# DeepSeek 官方（如果有单独的 Key）
# DEEPSEEK_API_KEY=
# OpenAI 兼容 BYOK（用户自带 Key）
# USER_OPENAI_API_KEY=
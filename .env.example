# 智论助手 · 环境变量样例
# ========================================
# 复制本文件为 .env，然后填入你的真实 Key。
# .env 已经被 .gitignore 排除，不会被推到 Git。
# 绝对不要把 Key 直接写进代码。

# ─── 必需①：硅基流动 API Key ──────────────────────────
# 从 https://cloud.siliconflow.cn/account/ak 申请
# 免费档：deepseek-ai/DeepSeek-V4-Flash、THUDM/GLM-Z1-9B-0414
# 付费档：deepseek-ai/DeepSeek-V4-Pro（paper_check 深度审计用）
SILICONFLOW_API_KEY=

# 可选：自定义 base URL（默认 https://api.siliconflow.cn/v1，一般不用改）
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ─── 必需②：智谱 BigModel API Key（v0.4 新增）─────────
# 从 https://bigmodel.cn/apikey/platform 申请
# 免费模型：glm-4.7-flash（**永久免费**，200K 上下文，混合思考 30B/A3B）
# 没填这个 Key 时，Router 会自动退回硅基流动的免费档（不影响服务）
ZHIPU_API_KEY=

# 可选：智谱自定义 base URL（默认 https://open.bigmodel.cn/api/paas/v4，一般不用改）
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ─── 可选：上线安全 / 限流（v1.7 · P2；本地内测用默认值即可）────────
# 普通接口每 IP 每分钟上限（默认 60）
# RATE_LIMIT_PER_MIN=60
# AI 接口每 IP 每分钟上限（默认 8；这类会真调外部 API，单独更严）
# RATE_LIMIT_LLM_PER_MIN=8
# 只有当服务跑在**可信反向代理**（Nginx/Cloudflare）后面时才设为 1。
# ⚠️ 直连公网时设 1 = 任何人都能靠伪造 X-Forwarded-For 绕过限流。
# TRUST_PROXY=0
# ⚠️ 仅测试/CI/本地单机内测用：设为 1 完全关闭限流。
# 生产环境绝对不要开（回归测试会连续打几十次 AI 接口，才需要它）。
# RATE_LIMIT_DISABLE=0

# ─── 可选：其它平台（v1.8 共 7 家；不填则自动跳过，不影响服务）────────
# 每个平台的 Key 缺失时，Router 会跳过该平台继续试下一个候选；
# 全部缺失时 AI 功能静默降级为规则模板，**核心统计功能照常可用**。

# 阿里云百炼（DashScope，OpenAI 兼容模式）
# https://bailian.console.aliyun.com/  免费额度较大，前缀缓存命中率高
# DASHSCOPE_API_KEY=

# 阿里云百炼 MaaS 专属工作空间（私有端点，尾位兜底）
# ⚠️ 需连同专属 VPC 端点一起配置，普通用户可留空
# MAAS_API_KEY=
# MAAS_BASE_URL=https://<你的专属端点>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# DeepSeek 官方（api.deepseek.com）
# DEEPSEEK_API_KEY=

# Kimi 开放平台（月之暗面，长上下文，适合整篇论文审计）
# 申请：https://platform.kimi.com ｜ 现役模型：kimi-k2.6 / kimi-k2.7-code
# 实测注意（2026-09）：①kimi-k2.6 只接受 temperature=1（Agent 已自动适配）；
# ②赠金档限 RPM=3，连续调用会 429；③前缀缓存自动生效但异步写入（65% 实测命中）
# KIMI_API_KEY=
# 国际版才需要覆盖：# KIMI_BASE_URL=https://api.moonshot.ai/v1

# 小米 MiMo 开放平台
# 申请：https://platform.xiaomimimo.com ｜ 现役模型：mimo-v2.5 / mimo-v2.5-pro
# 实测注意（2026-09）：首连接 6 秒+ 属正常（Agent 已放宽连接超时到 15s）；
# mimo-v2.5 是思考模型，小 max_tokens 会被思考吃光（默认已给 4096）
# MIMO_API_KEY=

# 各平台的 base URL 一般不用改（默认值见 agents/openai_compat.py 的 PROVIDER_REGISTRY）
# 需要改时用 <PLATFORM>_BASE_URL，例如：
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ---------------------------------------------------------------------------
# 部署 / 跨端（v2.7+）
# ---------------------------------------------------------------------------

# 监听地址与端口。对外提供 H5 服务时必须 HOST=0.0.0.0
# （绑 127.0.0.1 时容器/PaaS 映射出去的端口永远连不上）
# HOST=0.0.0.0
# PORT=5000

# 置于 Nginx / 云负载均衡之后时设为 1，否则限流器拿到的是代理 IP，
# 会把所有用户算成同一个人（表现为「操作太频繁」误伤）。
# ⚠️ 不设时一律不采信 X-Forwarded-For（防伪造换 IP 绕过限流）
# TRUST_PROXY=1

# 调试模式：生产环境务必保持 0（开了会暴露堆栈）。
# DEBUG=1

# 跨域白名单（逗号分隔）。默认空 = 不启用 CORS，浏览器同源访问不受影响。
# 仅当「H5 与后端不同源」或「第三方网页要调用」时才需要配。
# ⚠️ 微信小程序不需要 CORS（wx.request 不走同源策略），见 docs/CROSS_PLATFORM.md
# CORS_ALLOW_ORIGINS=https://app.example.com
# CORS_ALLOW_CREDENTIALS=1

# 限流阈值（次/分钟）。默认 60 / 8，面向内测；
# 小程序上线后同出口 IP 用户共享计数，需按预期并发调整。
# RATE_LIMIT_PER_MIN=60
# RATE_LIMIT_LLM_PER_MIN=8
